{
  "name": "agent-hub",
  "displayName": "Agent Hub",
  "description": "A sidebar for running Claude Code out of VS Code: new-task box, favourites, running and recent sessions and bookmarks.",
  "version": "0.82.5",
  "publisher": "pat-erler",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "enabledApiProposals": [
    "quickPickItemTooltip"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-hub",
          "title": "Agent Hub",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agent-hub": [
        {
          "id": "agentHub.ask",
          "name": "New Task",
          "type": "webview",
          "initialSize": 1
        },
        {
          "id": "agentHub.favourites",
          "name": "Favourites"
        },
        {
          "id": "agentHub.sessions",
          "name": "Recent Sessions"
        },
        {
          "id": "agentHub.bookmarks",
          "name": "Bookmarks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentHub.favourites",
        "contents": "No favourites yet.\n[Add Favourite](command:agentHub.addFavourite)\n[Add Current Workspace](command:agentHub.addCurrentWorkspace)"
      },
      {
        "view": "agentHub.bookmarks",
        "contents": "No bookmarks yet.\n[Add Bookmark](command:agentHub.addBookmark)"
      }
    ],
    "commands": [
      {
        "command": "agentHub.newSession",
        "title": "New Claude Session…",
        "icon": "$(rocket)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.goToFolder",
        "title": "Go to Folder…",
        "icon": "$(search)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.folderSearchNewSubfolder",
        "title": "Go to Folder: New Subfolder & Start Claude",
        "icon": "$(new-folder)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.addFavourite",
        "title": "Add Favourite…",
        "icon": "$(add)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.addCurrentWorkspace",
        "title": "Add Current Workspace",
        "icon": "$(root-folder)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.addFromExplorer",
        "title": "Add to Claude Favourites",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.startClaudeFromExplorer",
        "title": "Start Claude Here",
        "icon": "$(play)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.newFolderAndStartClaudeFromExplorer",
        "title": "New Folder & Start Claude…",
        "icon": "$(new-folder)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.resumeClaudeFromExplorer",
        "title": "Resume Claude Here",
        "icon": "$(debug-rerun)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.refreshQueueCounts",
        "title": "Refresh Queue Counts",
        "icon": "$(refresh)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.focusNewTask",
        "title": "Show the New Task Box",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.quickSession",
        "title": "Quick Session (Scratch)",
        "icon": "$(zap)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.uploadToToday",
        "title": "Upload to Today's Transfer Folder",
        "icon": "$(cloud-upload)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.refreshFavourites",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentHub.startClaude",
        "title": "Start New Session Here",
        "icon": "$(play)"
      },
      {
        "command": "agentHub.resumeClaude",
        "title": "Resume Claude",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "agentHub.openTerminalHere",
        "title": "Open Terminal Here",
        "icon": "$(terminal)"
      },
      {
        "command": "agentHub.openFolder",
        "title": "Open Folder in New Window",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentHub.revealInExplorer",
        "title": "Reveal in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentHub.copyPath",
        "title": "Copy Folder Path"
      },
      {
        "command": "agentHub.renameFavourite",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "agentHub.removeFavourite",
        "title": "Remove",
        "icon": "$(trash)"
      },
      {
        "command": "agentHub.moveUp",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "agentHub.moveDown",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "agentHub.revealTabCwd",
        "title": "Reveal Session Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentHub.openTabTask",
        "title": "Open Asana Task",
        "icon": "$(link-external)"
      },
      {
        "command": "agentHub.refreshSessions",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentHub.searchSessions",
        "title": "Search Sessions",
        "icon": "$(search)"
      },
      {
        "command": "agentHub.clearSessionSearch",
        "title": "Clear Session Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentHub.resumeSession",
        "title": "Resume Session",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "agentHub.resumeAndCompact",
        "title": "Resume and Compact",
        "icon": "$(fold)"
      },
      {
        "command": "agentHub.copySessionId",
        "title": "Copy Session ID"
      },
      {
        "command": "agentHub.copySessionPath",
        "title": "Copy Session File Path"
      },
      {
        "command": "agentHub.revealSessionFile",
        "title": "Reveal Session File in Explorer"
      },
      {
        "command": "agentHub.pinSession",
        "title": "Pin Session",
        "icon": "$(pin)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.unpinSession",
        "title": "Unpin Session",
        "icon": "$(pinned)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.hideSession",
        "title": "Hide Session",
        "icon": "$(eye-closed)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.showHiddenSessions",
        "title": "Show Hidden Sessions",
        "icon": "$(eye)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.deleteSession",
        "title": "Delete Session…",
        "icon": "$(trash)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.openSessionTask",
        "title": "Open Asana Task",
        "icon": "$(link-external)"
      },
      {
        "command": "agentHub.addBookmark",
        "title": "Add Bookmark…",
        "icon": "$(add)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.editBookmark",
        "title": "Edit Bookmark…",
        "icon": "$(edit)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.removeBookmark",
        "title": "Remove Bookmark",
        "icon": "$(trash)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.refreshBookmarks",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.openBookmark",
        "title": "Open Bookmark in Browser",
        "icon": "$(link-external)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.openBookmarksFile",
        "title": "Edit Bookmarks File",
        "icon": "$(json)",
        "category": "Agent Hub"
      },
      {
        "command": "agentHub.showHelp",
        "title": "Help: Badges, Unlock",
        "icon": "$(question)",
        "category": "Agent Hub"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentHub.folderSearchNewSubfolder",
          "when": "false"
        },
        {
          "command": "agentHub.focusNewTask",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentHub.goToFolder",
          "when": "view == agentHub.favourites",
          "group": "navigation@0"
        },
        {
          "command": "agentHub.refreshQueueCounts",
          "when": "view == agentHub.ask && agentHub.asanaAvailable",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.quickSession",
          "when": "view == agentHub.ask",
          "group": "navigation@2"
        },
        {
          "command": "agentHub.uploadToToday",
          "when": "view == agentHub.ask",
          "group": "navigation@3"
        },
        {
          "command": "agentHub.addFavourite",
          "when": "view == agentHub.favourites",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.addCurrentWorkspace",
          "when": "view == agentHub.favourites",
          "group": "navigation@2"
        },
        {
          "command": "agentHub.refreshFavourites",
          "when": "view == agentHub.favourites",
          "group": "navigation@3"
        },
        {
          "command": "agentHub.searchSessions",
          "when": "view == agentHub.sessions",
          "group": "navigation@0"
        },
        {
          "command": "agentHub.clearSessionSearch",
          "when": "view == agentHub.sessions && agentHub.sessionsFiltered",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.showHiddenSessions",
          "when": "view == agentHub.sessions && agentHub.hasHiddenSessions",
          "group": "navigation@2"
        },
        {
          "command": "agentHub.refreshSessions",
          "when": "view == agentHub.sessions",
          "group": "navigation@3"
        },
        {
          "command": "agentHub.addBookmark",
          "when": "view == agentHub.bookmarks",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.refreshBookmarks",
          "when": "view == agentHub.bookmarks",
          "group": "navigation@2"
        },
        {
          "command": "agentHub.openBookmarksFile",
          "when": "view == agentHub.bookmarks",
          "group": "1_ops@1"
        },
        {
          "command": "agentHub.showHelp",
          "when": "view == agentHub.ask",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "agentHub.startClaude",
          "when": "view == agentHub.favourites && viewItem == favourite || view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "inline@2"
        },
        {
          "command": "agentHub.resumeClaude",
          "when": "view == agentHub.favourites && viewItem == favourite",
          "group": "inline@1"
        },
        {
          "command": "agentHub.resumeSession",
          "when": "view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "inline@1"
        },
        {
          "command": "agentHub.revealInExplorer",
          "when": "view == agentHub.favourites && viewItem == favourite || view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "inline@3"
        },
        {
          "command": "agentHub.openSessionTask",
          "when": "view == agentHub.sessions && viewItem =~ /Asana/ && agentHub.asanaAvailable",
          "group": "inline@4"
        },
        {
          "command": "agentHub.startClaude",
          "when": "view == agentHub.favourites && viewItem == favourite || view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "1_run@1"
        },
        {
          "command": "agentHub.resumeClaude",
          "when": "view == agentHub.favourites && viewItem == favourite",
          "group": "1_run@2"
        },
        {
          "command": "agentHub.resumeSession",
          "when": "view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "1_run@2"
        },
        {
          "command": "agentHub.resumeAndCompact",
          "when": "view == agentHub.sessions && viewItem =~ /^session(Asana)?(Pinned)?$/",
          "group": "1_run@3"
        },
        {
          "command": "agentHub.openTerminalHere",
          "when": "view == agentHub.favourites && viewItem == favourite || view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "2_folder@1"
        },
        {
          "command": "agentHub.revealInExplorer",
          "when": "view == agentHub.favourites && viewItem == favourite || view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "2_folder@2"
        },
        {
          "command": "agentHub.openFolder",
          "when": "view == agentHub.favourites && viewItem == favourite || view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "2_folder@3"
        },
        {
          "command": "agentHub.copyPath",
          "when": "view == agentHub.favourites && viewItem == favourite || view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "2_folder@4"
        },
        {
          "command": "agentHub.openSessionTask",
          "when": "view == agentHub.sessions && viewItem =~ /Asana/ && agentHub.asanaAvailable",
          "group": "3_session@1"
        },
        {
          "command": "agentHub.revealSessionFile",
          "when": "view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "3_session@2"
        },
        {
          "command": "agentHub.copySessionId",
          "when": "view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "3_session@3"
        },
        {
          "command": "agentHub.copySessionPath",
          "when": "view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "3_session@4"
        },
        {
          "command": "agentHub.renameFavourite",
          "when": "view == agentHub.favourites && viewItem == favourite",
          "group": "4_manage@1"
        },
        {
          "command": "agentHub.moveUp",
          "when": "view == agentHub.favourites && viewItem == favourite",
          "group": "4_manage@2"
        },
        {
          "command": "agentHub.moveDown",
          "when": "view == agentHub.favourites && viewItem == favourite",
          "group": "4_manage@3"
        },
        {
          "command": "agentHub.removeFavourite",
          "when": "view == agentHub.favourites && viewItem == favourite",
          "group": "4_manage@9"
        },
        {
          "command": "agentHub.pinSession",
          "when": "view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?$/",
          "group": "4_manage@0"
        },
        {
          "command": "agentHub.unpinSession",
          "when": "view == agentHub.sessions && viewItem =~ /Pinned$/",
          "group": "4_manage@0"
        },
        {
          "command": "agentHub.hideSession",
          "when": "view == agentHub.sessions && viewItem =~ /^session(Live)?(Asana)?(Pinned)?$/",
          "group": "4_manage@1"
        },
        {
          "command": "agentHub.deleteSession",
          "when": "view == agentHub.sessions && viewItem =~ /^session(Asana)?(Pinned)?$/",
          "group": "4_manage@2"
        },
        {
          "command": "agentHub.editBookmark",
          "when": "view == agentHub.bookmarks && viewItem == bookmark",
          "group": "inline@1"
        },
        {
          "command": "agentHub.removeBookmark",
          "when": "view == agentHub.bookmarks && viewItem == bookmark",
          "group": "inline@2"
        },
        {
          "command": "agentHub.editBookmark",
          "when": "view == agentHub.bookmarks && viewItem == bookmark",
          "group": "3_edit@1"
        },
        {
          "command": "agentHub.removeBookmark",
          "when": "view == agentHub.bookmarks && viewItem == bookmark",
          "group": "3_edit@9"
        }
      ],
      "explorer/context": [
        {
          "command": "agentHub.startClaudeFromExplorer",
          "when": "explorerResourceIsFolder",
          "group": "claude-helper@1"
        },
        {
          "command": "agentHub.resumeClaudeFromExplorer",
          "when": "explorerResourceIsFolder",
          "group": "claude-helper@2"
        },
        {
          "command": "agentHub.newFolderAndStartClaudeFromExplorer",
          "when": "explorerResourceIsFolder",
          "group": "claude-helper@3"
        },
        {
          "command": "agentHub.addFromExplorer",
          "when": "explorerResourceIsFolder",
          "group": "claude-helper@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "agentHub.revealTabCwd",
          "when": "resourceScheme == vscode-terminal",
          "group": "2_files@1"
        },
        {
          "command": "agentHub.openTabTask",
          "when": "resourceScheme == vscode-terminal && agentHub.asanaAvailable",
          "group": "2_files@2"
        }
      ],
      "terminal/title/context": [
        {
          "command": "agentHub.revealTabCwd",
          "group": "2_files@1"
        },
        {
          "command": "agentHub.openTabTask",
          "when": "agentHub.asanaAvailable",
          "group": "2_files@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentHub.goToFolder",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "agentHub.folderSearchNewSubfolder",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "agentHub.folderSearchOpen"
      },
      {
        "command": "agentHub.revealActiveTerminalCwd",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "configuration": {
      "title": "Agent Hub",
      "properties": {
        "agentHub.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to invoke Claude Code."
        },
        "agentHub.skipPermissions": {
          "type": "boolean",
          "default": true,
          "description": "Append --dangerously-skip-permissions (YOLO)."
        },
        "agentHub.cliFlags": {
          "type": "string",
          "default": "",
          "description": "Additional CLI flags appended to every claude invocation."
        },
        "agentHub.defaultTerminalMode": {
          "type": "string",
          "enum": [
            "ask",
            "internal",
            "external"
          ],
          "enumDescriptions": [
            "Prompt each time",
            "Integrated terminal",
            "External system terminal"
          ],
          "default": "internal",
          "description": "Where to run claude when starting/resuming a session."
        },
        "agentHub.externalTerminalCommand": {
          "type": "string",
          "default": "",
          "description": "External terminal template. Placeholders: {cwd} {cmd}."
        },
        "agentHub.reuseTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Reuse a terminal with the same name instead of opening new ones."
        },
        "agentHub.confirmRemove": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation when removing a favourite."
        },
        "agentHub.folderSearchRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/clients",
            "~/projects",
            "~/hosting",
            "~/tasks"
          ],
          "description": "Roots scanned by \"Go to Folder…\" (Ctrl+Alt+P)."
        },
        "agentHub.folderSearchDepth": {
          "type": "number",
          "default": 3,
          "description": "How many levels below each root \"Go to Folder…\" descends."
        },
        "agentHub.folderSearchExcludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "venv",
            ".venv",
            "dist",
            "build",
            "__pycache__"
          ],
          "description": "Directory names \"Go to Folder…\" skips (and never descends into)."
        },
        "agentHub.folderSearchAction": {
          "type": "string",
          "enum": [
            "openFolder",
            "terminal",
            "startClaude",
            "newFolder",
            "reveal",
            "favourite"
          ],
          "enumDescriptions": [
            "Open the folder in a new window",
            "Open a terminal there",
            "Start Claude there",
            "Create a subfolder there and start Claude in it",
            "Reveal it in the Explorer",
            "Add it to Claude Favourites"
          ],
          "default": "reveal",
          "description": "What Enter does in \"Go to Folder…\". The other actions stay available as buttons on the highlighted row."
        },
        "agentHub.shortenPaths": {
          "type": "boolean",
          "default": true,
          "description": "Shorten paths by replacing $HOME with ~."
        },
        "agentHub.sessionsMaxAgeDays": {
          "type": "number",
          "default": 7,
          "description": "Only show sessions modified within the last N days in Recent Sessions."
        },
        "agentHub.sessionsExcludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/tmp"
          ],
          "description": "Hide sessions whose working directory is one of these paths or below it (throwaway scratchpad and temp-dir sessions). ~ is expanded."
        },
        "agentHub.sessionsMaxItems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of recent sessions to list."
        },
        "agentHub.agentIndexPath": {
          "type": "string",
          "default": "~/.claude/agent-sessions.json",
          "description": "Index of helper-launched tmux agent sessions (the Asana bridge no longer writes it). Open Asana Task finds bridge sessions through `claude agents --json` and the .asana-claude.json marker in their working directory."
        },
        "agentHub.agentTmuxSocket": {
          "type": "string",
          "default": "claude",
          "description": "tmux socket name (-L) used by bridge-spawned agent sessions."
        },
        "agentHub.useTmux": {
          "type": "boolean",
          "default": true,
          "description": "Run Start/Resume inside a tmux session on the agent socket (and attach the terminal to it) so sessions are reachable from Claude Mobile and survive reloads. Turn off to launch Claude directly in the terminal (legacy behavior)."
        },
        "agentHub.useDtach": {
          "type": "boolean",
          "default": true,
          "description": "When useTmux is off, launch Start/Resume inside a transparent dtach session and attach the terminal to it. dtach keeps draining Claude's output even when the browser/tab disconnects, so a closed tab no longer freezes the stream (the 'Stream idle timeout' on reconnect). Unlike tmux it has no alternate-screen, so native scroll + copy keep working. Turn off to launch Claude directly in the terminal (legacy behavior, freezes on disconnect)."
        },
        "agentHub.dtachSocketDir": {
          "type": "string",
          "default": "~/.claude/dtach",
          "description": "Directory for per-session dtach sockets (used when useDtach is on)."
        },
        "agentHub.replayHistory": {
          "type": "boolean",
          "default": true,
          "description": "dtach keeps no history, so a tab attached to a running session shows only one screenful. With this on, new sessions are recorded to <dtachSocketDir>/<session id>.log (via util-linux `script`) and the attach prints the tail of that log into the tab first, so you can scroll back through what you missed. Terminal queries are stripped from the replay. Off: no recording on new launches, plain attach."
        },
        "agentHub.replayHistoryBytes": {
          "type": "number",
          "default": 4194304,
          "minimum": 65536,
          "description": "How many bytes at the end of a session's log are replayed on attach (default 4 MB). Logs of running sessions are trimmed to this size once they pass twice of it."
        },
